# Kopieren nach .env und ausfuellen. NIEMALS echte Werte hier ins Repo committen!

# Public Key des Ziel-WG-Servers (z.B. isurfer.de), siehe eure wireguard-Repo-Doku (peer-allocation.md)
ISURFER_PUBKEY=CHANGE_ME_WIREGUARD_PUBLIC_KEY

# Oeffentlicher Endpoint des Ziel-WG-Servers, Format host:port
ISURFER_ENDPOINT=CHANGE_ME_HOST:51820

# Tunnel-IP, die dieser Container selbst im WG-Netz bekommt (freies Oktett waehlen)
CONTAINER_WG_IP=10.250.0.250

# Tunnel-IP des Ziel-WG-Servers selbst (Ziel fuer SSH-Management)
ISURFER_WG_IP=10.250.0.1

# Name des WireGuard-Interfaces AUF DEM ZIELSERVER (nicht des Containers).
# Haeufig "wg0", kann aber abweichen (z.B. "WG-Logging" bei einem MikroTik-Router).
TARGET_WG_INTERFACE=wg0

# SSH-User auf dem Zielserver, unter dem die iptables-Befehle ausgefuehrt werden
ISURFER_SSH_USER=root

# Zufaelligen Wert eintragen (z.B. mit: openssl rand -hex 32)
FLASK_SECRET=

# Optional, aber dringend empfohlen sobald der Port nicht mehr nur auf
# localhost erreichbar ist: HTTP-Basic-Auth fuer die Web-UI.
# Leer lassen = keine Authentifizierung (nur fuer vertrauenswuerdiges,
# lokales Netz vertretbar).
ADMIN_USER=
ADMIN_PASSWORD=

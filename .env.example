# Kopieren nach .env und ausfuellen

# Public Key von isurfer.de (steht bereits in eurer wireguard-Repo-Doku, peer-allocation.md)
ISURFER_PUBKEY=CHANGE_ME_WIREGUARD_PUBLIC_KEY

# Oeffentlicher Endpoint von isurfer.de
ISURFER_ENDPOINT=CHANGE_ME_HOST:51820

# Tunnel-IP, die dieser Container selbst im WG-Netz bekommt (freies Oktett waehlen)
CONTAINER_WG_IP=10.250.0.250

# Tunnel-IP von isurfer.de selbst (Ziel fuer SSH-Management)
ISURFER_WG_IP=10.250.0.1

# Name des WireGuard-Interfaces AUF DEM ZIELSERVER (nicht des Containers).
# isurfer.de nutzt "wg0". Bei anderen Servern kann das abweichen
# (z.B. "WG-Logging" bei einem eurer eigenen MikroTik-Router).
TARGET_WG_INTERFACE=wg0

# SSH-User auf isurfer.de, unter dem die iptables-Befehle ausgefuehrt werden
ISURFER_SSH_USER=root

# Zufaelligen Wert eintragen (z.B. mit: openssl rand -hex 32)
FLASK_SECRET=

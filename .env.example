# Kopieren nach .env und ausfuellen. NIEMALS echte Werte hier ins Repo committen!

# Ausfuehrungsmodus:
#   ssh   (Standard) - Container laeuft auf einer SEPARATEN Maschine, baut
#         einen eigenen WG-Tunnel zum Ziel-Server auf und verwaltet dort
#         per SSH die iptables-Regeln. Braucht die WG_SERVER_*-Variablen
#         unten. Siehe docker-compose.yml.
#   local - Container laeuft DIREKT auf dem WireGuard-Server selbst und
#         verwaltet iptables ohne Tunnel/SSH direkt auf dem Host. Braucht
#         "network_mode: host" + "cap_add: NET_ADMIN" (siehe
#         docker-compose.local.yml). Von den WG_SERVER_*-Variablen unten
#         wird in diesem Modus nur WG_SERVER_ENDPOINT gebraucht (fuer die
#         Client-Provisionierung, siehe "Client bereitstellen").
EXEC_MODE=ssh

# --- Public Key des Ziel-WG-Servers, siehe eure WireGuard-Doku (peer-allocation.md) ---
# Nur fuer EXEC_MODE=ssh relevant.
WG_SERVER_PUBKEY=CHANGE_ME_WIREGUARD_PUBLIC_KEY

# Oeffentlicher Endpoint des Ziel-WG-Servers, Format host:port.
# In beiden Modi relevant: EXEC_MODE=ssh nutzt ihn fuer den eigenen Tunnel,
# EXEC_MODE=local nutzt ihn nur fuer generierte Client-Configs ("Client
# bereitstellen") - der Server kennt seine eigene oeffentliche Adresse sonst
# nicht zuverlaessig.
WG_SERVER_ENDPOINT=CHANGE_ME_HOST:51820

# Tunnel-IP, die dieser Container selbst im WG-Netz bekommt (freies Oktett waehlen)
# Nur fuer EXEC_MODE=ssh relevant.
CONTAINER_WG_IP=10.250.0.250

# Tunnel-IP des Ziel-WG-Servers selbst (Ziel fuer SSH-Management)
# Nur fuer EXEC_MODE=ssh relevant.
WG_SERVER_TUNNEL_IP=10.250.0.1

# Name des WireGuard-Interfaces AUF DEM ZIELSERVER (nicht des Containers).
# Haeufig "wg0", kann aber abweichen (z.B. "WG-Logging" bei einem MikroTik-Router).
TARGET_WG_INTERFACE=wg0

# SSH-User auf dem Zielserver, unter dem die iptables-Befehle ausgefuehrt werden
# Nur fuer EXEC_MODE=ssh relevant.
WG_SERVER_SSH_USER=root

# Zufaelligen Wert eintragen (z.B. mit: openssl rand -hex 32)
FLASK_SECRET=

# Optional, aber dringend empfohlen sobald der Port nicht mehr nur auf
# localhost erreichbar ist: HTTP-Basic-Auth fuer die Web-UI.
# Leer lassen = keine Authentifizierung (nur fuer vertrauenswuerdiges,
# lokales Netz vertretbar).
ADMIN_USER=
ADMIN_PASSWORD=

# Optional: Ports fuer das rsyslog-/MikroTik-Logging-Forwarding in den von
# "Client bereitstellen" generierten Setup-Skripten. Der Ziel-Host dafuer
# wird automatisch aus der WireGuard-Config des Servers abgeleitet.
PROVISION_SYSLOG_PORT_LINUX=5141
PROVISION_SYSLOG_PORT_MIKROTIK=5140

# Optional: IP-Bereiche (letztes Oktett im WG-Subnetz) je Client-Typ, aus
# denen "Client bereitstellen" die naechste freie IP vorschlaegt - Server,
# Router und (End-User-)Clients bekommen so konsistent getrennte Adress-
# bereiche statt irgendeiner freien IP im gesamten Subnetz. Format "start-end".
IP_RANGE_SERVER=2-50
IP_RANGE_ROUTER=100-150
IP_RANGE_CLIENT=201-245
